# CivicLens AI Configuration

# FastAPI Backend
API_V1_STR=/api/v1
DEBUG=True

# Database (Default uses local SQLite for instant zero-dependency out-of-the-box run,
# or uncomment for PostgreSQL + PostGIS)
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/civiclens
DATABASE_URL=sqlite:///backend/civiclens.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram Bot Dispatch (Optional for real Telegram alerts, otherwise runs in simulation mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Emergency Webhook
EMERGENCY_WEBHOOK_URL=

# Default Municipality
DEFAULT_MUNICIPALITY=Greater Visakhapatnam Municipal Corporation (GVMC)
DEFAULT_ZONE=Zone 3
DEFAULT_WARD=Ward 14

